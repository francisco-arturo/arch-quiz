# Server-side only. Copy to `.env.local` and fill in real values.
# The API key is read by app/api/assess/route.ts and is never exposed to the browser.

# DeepSeek API key (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model name. deepseek-chat = fast/cheap (recommended default);
# deepseek-v4-pro = higher-quality reasoning, slower.
DEEPSEEK_MODEL=deepseek-chat

# Optional override for the API base URL.
DEEPSEEK_BASE_URL=https://api.deepseek.com
